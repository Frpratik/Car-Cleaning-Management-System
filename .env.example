# ==========================================
# AURACAR OS PRODUCTION CONFIGURATION
# ==========================================

# Server & Runtime
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://auracar_admin:secure_password@localhost:5432/auracar_db?schema=public

# Security & JWT Authentication
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_signing_key_change_in_production

# Super Admin Initial Master Credentials (For Initial Seed)
SUPER_ADMIN_EMAIL=superadmin@auracar.com
SUPER_ADMIN_PHONE=9900000000
SUPER_ADMIN_INITIAL_PASSWORD=SuperAdmin@AuraCar2026!

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Transactional Email (Resend / SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_placeholder_api_key
SMTP_FROM="AuraCar Operations <notifications@auracar.com>"

# Storage (AWS S3 / Cloudflare R2 for Service Proof Photos)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET_NAME=auracar-service-proofs
S3_ACCESS_KEY_ID=placeholder_access_key
S3_SECRET_ACCESS_KEY=placeholder_secret_key
S3_PUBLIC_DOMAIN=https://proofs.auracar.com

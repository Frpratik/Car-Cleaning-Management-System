// =========================================================================
// AuraCar OS — Multi-Tenant Residential Car Care SaaS Database Schema
// PostgreSQL 16 Relational Engine
// =========================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------------------
// 1. Core Authentication, RBAC & Multi-Tenancy Hierarchy
// -------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN     // Platform owner (Our company)
  SOCIETY_ADMIN   // Residential Society / RWA Facility Manager
  CUSTOMER        // Society Resident / Car Owner
  PROVIDER        // Assigned Cleaning Specialist
}

model User {
  id                String          @id @default(uuid())
  phoneNumber       String          @unique
  email             String?         @unique
  passwordHash      String
  fullName          String
  role              UserRole        @default(CUSTOMER)
  
  // Tenancy isolation (Null for Super Admin, mandatory for Society Admin/Customer/Provider)
  societyId         String?
  society           Society?        @relation(fields: [societyId], references: [id], onDelete: SetNull)

  isEmailVerified   Boolean         @default(false)
  mustResetPassword Boolean         @default(false)
  isActive          Boolean         @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customerProfile   CustomerProfile?
  providerProfile   ProviderProfile?
  adminProfile      AdminProfile?
  auditLogs         AuditLog[]

  @@index([role, societyId])
}

// Single-Use Cryptographic Invitation Tokens
model InvitationToken {
  id                String          @id @default(uuid())
  societyId         String
  society           Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  email             String
  role              UserRole        @default(CUSTOMER)
  tokenHash         String          @unique // SHA256 hashed single-use token
  apartmentUnitId   String?
  apartmentUnit     ApartmentUnit?  @relation(fields: [apartmentUnitId], references: [id])
  isRedeemed        Boolean         @default(false)
  redeemedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime        @default(now())

  @@index([tokenHash, isRedeemed, expiresAt])
}

model CustomerProfile {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  apartmentUnitId   String?
  apartmentUnit     ApartmentUnit?  @relation(fields: [apartmentUnitId], references: [id])
  apartmentNumber   String?         // Denormalized string e.g. "Tower 1 - Floor 12 - Flat 1204"
  alternatePhone    String?
  
  vehicles          Vehicle[]
  subscriptions     Subscription[]
  payments          Payment[]
  ratings           Rating[]
  complaints        Complaint[]
}

model ProviderProfile {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeNumber       String          @unique
  assignedSocietyId String?
  society           Society?        @relation(fields: [assignedSocietyId], references: [id])
  isVerified        Boolean         @default(false)
  kycDocType        String?         // AADHAAR, VOTER_ID, DRIVING_LICENSE
  kycDocNumber      String?
  payoutUpiId       String?
  ratingAverage     Float           @default(5.0)
  totalJobsDone     Int             @default(0)
  isOnline          Boolean         @default(true)
  checkInTime       String?
  
  assignedJobs      ServiceJob[]
}

model AdminProfile {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        String          @default("OPERATIONS")
}

// -------------------------------------------------------------------------
// 2. Society Tenant & B2B Commercial Management
// -------------------------------------------------------------------------

enum TenantStatus {
  PROVISIONED
  ONBOARDING
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

model Society {
  id                    String              @id @default(uuid())
  name                  String              // e.g. "Prestige Lakeside Habitat"
  code                  String              @unique // e.g. "PLH-BLR"
  addressLine           String
  locality              String              // e.g. "Whitefield"
  city                  String              // e.g. "Bengaluru"
  state                 String              @default("Karnataka")
  pincode               String
  waterPolicy           String              @default("WATERLESS_ONLY")
  timezone              String              @default("Asia/Kolkata")
  
  tenantStatus          TenantStatus        @default(ACTIVE)
  subscriptionStartDate DateTime            @default(now())
  subscriptionEndDate   DateTime?
  maxUnits              Int                 @default(500)
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  users                 User[]
  towers                BuildingTower[]
  parkingLevels         ParkingLevel[]
  providers             ProviderProfile[]
  jobs                  ServiceJob[]
  onboardingState       SocietyOnboarding?
  commissionRules       CommissionRule[]
  complaints            Complaint[]
  invitations           InvitationToken[]
}

// Public Inbound Sales Lead / Enquiry from Commercial Website
enum EnquiryStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  PROPOSAL_SENT
  CONVERTED
  ARCHIVED
}

model SocietyEnquiry {
  id                String          @id @default(uuid())
  societyName       String
  contactPerson     String
  email             String
  phoneNumber       String
  city              String
  estimatedUnits    Int?
  estimatedVehicles Int?
  message           String?
  status            EnquiryStatus   @default(NEW)
  internalNotes     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, createdAt])
}

// 9-Step Society Admin Onboarding Checklist
model SocietyOnboarding {
  id                String          @id @default(uuid())
  societyId         String          @unique
  society           Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  currentStep       Int             @default(1)
  isCompleted       Boolean         @default(false)
  
  step1Details      Boolean         @default(true)
  step2Buildings    Boolean         @default(false)
  step3Parking      Boolean         @default(false)
  step4Slots        Boolean         @default(false)
  step5Services     Boolean         @default(false)
  step6Providers    Boolean         @default(false)
  step7Residents    Boolean         @default(false)
  step8Settings     Boolean         @default(false)
  step9Launched     Boolean         @default(false)
  
  completedAt       DateTime?
  updatedAt         DateTime        @updatedAt
}

// Dynamic Platform vs Provider vs Society Revenue Share
model CommissionRule {
  id                    String      @id @default(uuid())
  societyId             String?     // Null = Global Default, Specific = Tenant Override
  society               Society?    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  name                  String      @default("Standard 40/60 Split")
  platformFeePercentage Float       @default(40.0) // 40% platform gross margin
  providerPayoutRate    Int         @default(22)   // ₹22 fixed payout per car cleaned
  societySharePercent   Float       @default(0.0)  // Optional RWA revenue share
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
}

// Immutable Tamper-Evident Audit Log
model AuditLog {
  id                String          @id @default(uuid())
  actorUserId       String?
  actor             User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole         UserRole
  societyId         String?
  action            String          // e.g. "SOCIETY_CREATED", "REFUND_ISSUED", "CLEANER_REASSIGNED"
  resourceType      String          // e.g. "Subscription", "Payment", "ServiceJob"
  resourceId        String?
  metadataJson      String?         // Serialized JSON with before/after state
  ipAddress         String?
  createdAt         DateTime        @default(now())

  @@index([societyId, action, createdAt])
}

// -------------------------------------------------------------------------
// 3. Physical Building & Parking Hierarchy
// -------------------------------------------------------------------------

model BuildingTower {
  id          String          @id @default(uuid())
  societyId   String
  society     Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  name        String          // e.g. "Tower 1 (Oak)"
  totalFloors Int             @default(29)
  
  floors      BuildingFloor[]
  slots       ParkingSlot[]
  
  @@unique([societyId, name])
}

model BuildingFloor {
  id          String          @id @default(uuid())
  towerId     String
  tower       BuildingTower   @relation(fields: [towerId], references: [id], onDelete: Cascade)
  floorNumber Int             // e.g. 12
  floorLabel  String          // e.g. "12th Floor"
  
  apartments  ApartmentUnit[]

  @@unique([towerId, floorNumber])
}

model ApartmentUnit {
  id          String            @id @default(uuid())
  floorId     String
  floor       BuildingFloor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  unitNumber  String            // e.g. "1204"
  unitType    String            @default("3BHK") // 1BHK, 2BHK, 3BHK, 4BHK, PENTHOUSE
  
  residents   CustomerProfile[]
  invitations InvitationToken[]

  @@unique([floorId, unitNumber])
}

model ParkingLevel {
  id          String        @id @default(uuid())
  societyId   String
  society     Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  name        String        // e.g. "Basement 1", "Basement 2", "Podium Level"
  code        String        // "B1", "B2", "POD"
  
  slots       ParkingSlot[]

  @@unique([societyId, code])
}

model ParkingSlot {
  id              String        @id @default(uuid())
  towerId         String
  tower           BuildingTower @relation(fields: [towerId], references: [id], onDelete: Cascade)
  parkingLevelId  String?
  parkingLevel    ParkingLevel? @relation(fields: [parkingLevelId], references: [id], onDelete: SetNull)
  level           String        // Denormalized level string e.g. "Basement 2"
  slotNumber      String        // "B2-104"
  walkingSequence Int           @default(0) // Physical ordered sequence for cleaners
  isOccupied      Boolean       @default(false)
  
  vehicles        Vehicle[]
  jobs            ServiceJob[]

  @@unique([towerId, level, slotNumber])
  @@index([walkingSequence])
}

// -------------------------------------------------------------------------
// 4. Vehicles & Service Plans
// -------------------------------------------------------------------------

enum VehicleType {
  HATCHBACK
  SEDAN
  COMPACT_SUV
  SUV_LUXURY
}

model Vehicle {
  id              String          @id @default(uuid())
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  make            String          // e.g. "Toyota"
  model           String          // e.g. "Fortuner"
  color           String          // e.g. "Pearl White"
  registrationNo  String          @unique // e.g. "KA 03 MX 4492"
  type            VehicleType     @default(SEDAN)
  slotId          String
  parkingSlot     ParkingSlot     @relation(fields: [slotId], references: [id])
  notes           String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  subscriptions   Subscription[]
  jobs            ServiceJob[]
}

enum PlanFrequency {
  DAILY
  ALTERNATE_DAYS
  THREE_WEEKLY
  WEEKLY
}

model ServicePlan {
  id              String          @id @default(uuid())
  name            String
  code            String          @unique
  frequency       PlanFrequency   @default(DAILY)
  description     String
  hatchbackPrice  Int
  sedanPrice      Int
  suvPrice        Int
  inclusions      String[]
  isActive        Boolean         @default(true)

  subscriptions   Subscription[]
}

// -------------------------------------------------------------------------
// 5. Subscriptions & Automated Work Orders
// -------------------------------------------------------------------------

enum SubscriptionStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model Subscription {
  id              String              @id @default(uuid())
  customerId      String
  customer        CustomerProfile     @relation(fields: [customerId], references: [id])
  vehicleId       String
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id])
  servicePlanId   String
  plan            ServicePlan         @relation(fields: [servicePlanId], references: [id])
  status          SubscriptionStatus  @default(PENDING_PAYMENT)
  monthlyAmount   Int
  startDate       DateTime
  endDate         DateTime?
  pausedUntil     DateTime?
  nextBillingDate DateTime?
  preferredWindow String              @default("06:00-08:00")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  jobs            ServiceJob[]
  payments        Payment[]

  @@index([status, nextBillingDate])
}

enum JobStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  MISSED
  UNABLE_TO_SERVICE
  CANCELLED
}

model ServiceJob {
  id                String          @id @default(uuid())
  subscriptionId    String
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id])
  vehicleId         String
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id])
  societyId         String
  society           Society         @relation(fields: [societyId], references: [id])
  slotId            String
  parkingSlot       ParkingSlot     @relation(fields: [slotId], references: [id])
  providerId        String?
  provider          ProviderProfile? @relation(fields: [providerId], references: [id])
  
  serviceDate       DateTime
  timeWindow        String
  status            JobStatus       @default(SCHEDULED)
  startedAt         DateTime?
  completedAt       DateTime?
  exceptionReason   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  proof             ServiceProof?
  rating            Rating?
  complaints        Complaint[]

  @@unique([vehicleId, serviceDate])
  @@index([societyId, serviceDate, status])
}

model ServiceProof {
  id              String      @id @default(uuid())
  jobId           String      @unique
  job             ServiceJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  beforePhotoUrl  String
  afterPhotoUrl   String
  beforeTakenAt   DateTime
  afterTakenAt    DateTime
  syncTimestamp   DateTime    @default(now())
  durationMinutes Int         @default(15)
  watermarkHash   String?
}

// -------------------------------------------------------------------------
// 6. Payments, Invoicing & Webhook Idempotency
// -------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Payment {
  id                String          @id @default(uuid())
  subscriptionId    String
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id])
  customerId        String
  customer          CustomerProfile @relation(fields: [customerId], references: [id])
  amount            Int
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  invoiceNumber     String?         @unique
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?         @unique
  paymentMethod     String          @default("UPI_AUTOPAY")
  createdAt         DateTime        @default(now())
}

// Webhook Idempotency Event Registry
model PaymentWebhookEvent {
  id                String          @id @default(uuid())
  eventId           String          @unique // Razorpay event_id
  eventType         String          // payment.captured, payment.failed, etc.
  payloadJson       String
  isProcessed       Boolean         @default(false)
  processedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@index([eventId, isProcessed])
}

model Rating {
  id              String          @id @default(uuid())
  jobId           String          @unique
  job             ServiceJob      @relation(fields: [jobId], references: [id])
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id])
  score           Int             // 1 to 5 stars
  feedback        String?
  createdAt       DateTime        @default(now())
}

enum ComplaintCategory {
  MISSED_SPOTS
  SCRATCH_CLAIM
  LATE_SERVICE
  CLEANER_UNAVAILABLE
  OTHER
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REFUNDED
  REJECTED
}

model Complaint {
  id              String              @id @default(uuid())
  societyId       String
  society         Society             @relation(fields: [societyId], references: [id])
  jobId           String
  job             ServiceJob          @relation(fields: [jobId], references: [id])
  customerId      String
  customer        CustomerProfile     @relation(fields: [customerId], references: [id])
  category        ComplaintCategory   @default(MISSED_SPOTS)
  description     String
  status          ComplaintStatus     @default(OPEN)
  resolutionNote  String?
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([societyId, status])
}
